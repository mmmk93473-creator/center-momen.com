# ====================================================================
# MOMEN CENTER LUXURY FASHION - ENVIRONMENT VARIABLES
# ====================================================================

# 1. Supabase Project URL (From Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anonymous Public Key (Safe to expose in the browser)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-here

# ⚠️ SECURITY WARNING:
# NEVER put the SUPABASE_SERVICE_ROLE_KEY in this file or any file with VITE_ prefix.
# Service-role keys bypass all Row Level Security and must never be sent to the browser!
